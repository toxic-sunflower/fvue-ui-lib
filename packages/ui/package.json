{
  "name": "fvue-ui-lib",
  "version": "0.1.2",
  "description": "Unofficial Vue 3 port of the Fanvue UI library (@fanvue/ui): same look, props and behavior for Vue apps. Not affiliated with Fanvue.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/toxic-sunflower/fvue-ui-lib.git"
  },
  "homepage": "https://github.com/toxic-sunflower/fvue-ui-lib#readme",
  "bugs": {
    "url": "https://github.com/toxic-sunflower/fvue-ui-lib/issues"
  },
  "keywords": ["vue", "vue3", "ui", "components", "design-system", "tailwindcss", "reka-ui", "fanvue", "unofficial"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.mjs",
      "require": "./dist/cjs/charts.cjs"
    },
    "./date-picker": {
      "types": "./dist/date-picker.d.ts",
      "import": "./dist/date-picker.mjs",
      "require": "./dist/cjs/date-picker.cjs"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "import": "./dist/flags.mjs",
      "require": "./dist/cjs/flags.cjs"
    },
    "./animated-icons": {
      "types": "./dist/animated-icons.d.ts",
      "import": "./dist/animated-icons.mjs",
      "require": "./dist/cjs/animated-icons.cjs"
    },
    "./styles/components.css": "./dist/fvue-ui-lib.css",
    "./theme.css": "./src/theme.css",
    "./base.css": "./src/base.css"
  },
  "files": ["dist", "src/theme.css", "src/base.css", "README.md", "CHANGELOG.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "bunx --bun vite build && LIB_FORMAT=cjs bunx --bun vite build && bun ./scripts/build-cjs.mjs",
    "sync:theme": "bun ./scripts/sync-theme.mjs",
    "typecheck": "bunx --bun vue-tsc --noEmit -p tsconfig.json",
    "test": "bunx --bun vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@fanvue/ui": "3.43.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.10"
  }
}
